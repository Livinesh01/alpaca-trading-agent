# ---------------------------------------------------------------------------
# Sentinel / EPSILON — Environment Configuration Template
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit the copied `.env`. Production deployments MUST inject secrets
# via the platform secret manager (Vercel / Render / Fly.io / Render), never
# via this file.
#
# PAPER TRADING ONLY — this system NEVER supports live-money trading.
# ---------------------------------------------------------------------------

# === Core deployment mode ==================================================
# APP_ENV=production     — production fail-closed validation
# APP_ENV=development    — local development with X-Dev-Role auth
# APP_ENV=paper          — paper deployment with JWT auth (non-production)
APP_ENV=development
TRADING_MODE=paper          # Must be "paper" in all environments.
PAPER_TRADING=true          # Must be true. Live trading is NOT implemented.
ALPACA_PAPER=true           # Must be true. Alpaca paper endpoint only.
ALPACA_PAPER_TRADE=true     # Must be true. Redundant paper-only guard.
TRADING_ENABLED=true        # Set to false (or TRADING_KILL_SWITCH=true) to
                            # disable the kill switch / enable trading.
TRADING_KILL_SWITCH=false   # Emergency stop — rejects ALL order submissions.

# === Alpaca Paper Trading API =============================================
# Get free paper keys at https://alpaca.markets
# NEVER use live API keys — the system rejects them.
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets  # paper only; never live

# === LLM Provider ==========================================================
# LLM_PROVIDER selects 'featherless' or 'nvidia' (or 'fake' for tests only).
LLM_PROVIDER=featherless
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=

# NVIDIA NIM (OpenAI-compatible) — used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

# === LLM Reliability =======================================================
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# === Market Data ===========================================================
# SENTINEL_DATA_MODE=proxy   — real Alpaca paper market data (production)
# SENTINEL_DATA_MODE=offline — simulated/demo data (development only)
SENTINEL_DATA_MODE=offline
MARKET_DATA_MAX_AGE_SECONDS=120.0

# === Database (PostgreSQL) ================================================
# Production requires PostgreSQL. Leave empty for local development (SQLite fallback).
DATABASE_URL=
JWT_SIGNING_SECRET=                        # Min 32 chars; set for production auth
JWT_ALGORITHM=HS256                        # HS256, RS256, RS384, RS512, ES256, ES384, ES512
JWT_ISSUER=                                # Optional: JWT issuer claim
JWT_AUDIENCE=                              # Optional: JWT audience claim

# === API Security & Rate Limiting =========================================
# API_AUTH_MODE=production  — JWT bearer token auth (production)
# API_AUTH_MODE=development — X-Dev-Role header (development only)
# API_AUTH_MODE=disabled    — no auth (testing only)
API_AUTH_MODE=disabled
API_CORS_ORIGINS=                          # Comma-separated allowed origins
API_RATE_LIMIT_PER_MINUTE=120

# === Risk Limits ===========================================================
MAX_POSITION_NOTIONAL_USD=10000.0
MAX_ORDER_NOTIONAL_USD=5000.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_USD=1000.0
MAX_ORDERS_PER_RUN=3
ALLOW_SHORT_SELLING=false
ALLOW_OPTIONS=false
ALLOW_CRYPTO=false
WATCHLIST=AAPL,MSFT,NVDA,SPY,TSLA

# === Worker ================================================================
AGENT_BACKEND=decision_loop
WORKER_INTERVAL_SECONDS=900

# === Local Development Only ===============================================
# Production workers must use deployment secrets and leave this disabled so
# workspace .env files are never imported implicitly.
SENTINEL_LOAD_DOTENV=false

# === Cline CLI (orchestrator mode) ========================================
# Optional; defaults are 600s and 6 retries.
CLINE_RUN_TIMEOUT_SECONDS=600
CLINE_MAX_RETRIES=6