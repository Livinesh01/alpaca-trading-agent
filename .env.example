# Copy this to `.env` and fill in your own values (never commit `.env`).
# Alpaca paper-trading credentials — used by the risk-guard proxy, which is
# launched as the `alpaca` MCP server by Cline.
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true
ALPACA_PAPER_TRADE=true

# Cline-specific knobs read by src/orchestrator.py when invoking the Cline CLI.
# These are optional; defaults are 600s and 6 retries.
CLINE_RUN_TIMEOUT_SECONDS=600
CLINE_MAX_RETRIES=6

# Featherless AI (OpenAI-compatible) — read by src/agent/llm.py.
# FEATHERLESS_MODEL must be non-empty when the provider is used.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=

# NVIDIA NIM (OpenAI-compatible) — read by src/agent/llm.py.
# NVIDIA_MODEL is optional; defaults to deepseek-ai/deepseek-v4-pro-0813.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813


# Deployment mode is explicit: development uses X-Dev-Role, paper requires
# configured authentication, and production is fail-closed until OIDC/OAuth2
# and a verified paper execution path are integrated.
APP_ENV=development
SENTINEL_ENVIRONMENT=development
TRADING_MODE=paper

# Paper-only DecisionLoop backend in src/orchestrator.py (the default backend).
# PAPER_TRADING must be explicitly true for run_once() to use the DecisionLoop;
# anything else fails closed. AGENT_BACKEND selects 'decision_loop' (default)
# or 'cline' (development/fallback). LLM_PROVIDER selects 'featherless' or
# 'nvidia' (keys/models above).
PAPER_TRADING=false
AGENT_BACKEND=decision_loop
LLM_PROVIDER=featherless

# Emergency stop: set to true and the final executor gate refuses EVERY order
# submission (checked immediately before any order leaves the process).
TRADING_KILL_SWITCH=false

# LLM Reliability Configuration
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# Market Data Freshness (seconds)
MARKET_DATA_MAX_AGE_SECONDS=120.0
SENTINEL_DATA_MODE=offline

# API Security & Rate Limiting
API_AUTH_MODE=disabled
API_CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120

# Local development only. Production workers must use deployment secrets and
# leave this disabled so workspace .env files are never imported implicitly.
SENTINEL_LOAD_DOTENV=false