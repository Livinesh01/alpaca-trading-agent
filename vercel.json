{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "VITE_API_BASE_URL": "https://api.sentinel.example.com"
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/$1",
      "methods": [
        "GET",
        "HEAD"
      ]
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html",
      "methods": [
        "GET",
        "HEAD"
      ]
    }
  ]
}
